<Window x:Class="TestDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestDE"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#7FFF00">
            <Image Source="/Images/Icon.ico" HorizontalAlignment="Left" Margin="5"/>
            <TextBlock Text="ОБУВЬ" HorizontalAlignment="Left" Margin="50,10,0,0"/>
            <Button Name="BackButton" Content="Назад" HorizontalAlignment="Left" Margin="722,15,0,0" VerticalAlignment="Top" Click="BackButton_Click"/>
        </Grid>
        <Frame Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
